#definicion de funciones

definir esPar(pnum):
    retornar pnum%2==0

definir esPalindromo(palabra):
    palabra = palabra.lower()
    retornar longitud(palabra) > 1 y palabra == palabra[::-1]

definir esInfinitivo(palabra):
    terminaciones = ('ar', 'er', 'ir', 'o', 'ur')
    retornar palabra.lower().endswith(terminaciones)

definir contarParesImpares(ptupla):
    pares=0
    impares=0
    por i en ptupla:
        si i//1000>=0 y i//1000<10:
            si esPar(i):
                pares+=1
            sino:
                impares+=1
        sino:
            retornar "Debe ser un número natural de 4 dígito"
    retornar (pares,impares)

definir separarParesImpares(ptupla):
    pares=[]
    impares=[]
    por i en ptupla:
        si i//1000>=0 y i//1000<10:
            si esPar(i):
                pares.adjuntar(i)
            sino:
                impares.adjuntar(i)
        sino:
            retornar "Debe ser un número natural de 4 dígito"
    retornar (pares,impares)

definir categorizarPalabras(ptupla):
    si no tipo(ptupla)==tupla:
        retornar "Debe ingresar una tupla obligatoriamente"
    infinitivos = []
    palindromos = []
    por frase en ptupla:
        palabras=frase.lower().dividir()
        por i en palabras:
            palabraLimpia=i.limpiar(",.-_:;´+}¨*]{[!#$%&/()=?'¿¡|°")
            si esInfinitivo(palabraLimpia):
                infinitivos.adjuntar(palabraLimpia)
            si esPalindromo(palabraLimpia):
                palindromos.adjuntar(palabraLimpia)
    retornar [infinitivos,palindromos]

definir esNumPerfeto (pnum):
    suma=0
    por i en rango (1, pnum):
        si pnum%i==0:
            suma+=i
    retornar suma==pnum

definir esNumPerfectoAux(ptupla):
    resultado=[]
    si longitud(ptupla)==5:    
        por i en ptupla:
            si esNumPerfeto(i):
                resultado.adjuntar(i)
        si resultado==[]:
            retornar "no hay números perfectos"
    sino:
        retornar "debe indicar exactamente 5 valores de entrada para analizar"
    retornar resultado

definir obtenerDiferencia(pnum1, pnum2):
    """
    Funcionalidad:
    retorna un número formado por los dígitos que están en el primer número 
    pero no aparecen en el segundo número, manteniendo el orden original
    Entradas: 
    - pnum1(entero): número 1 a valorar
    - pnum2(entero): número 2 a valorar
    Salidas: 
    - resultado(entero): número quitando los digitos de pnum2
    -Falso(bool): indicando que no hay números que se repitan 
    """
    cadena1=cadena(pnum1)
    cadena2=cadena(pnum2)
    resultadoFinal=""
    por digitoActual en cadena1:
        si digitoActual no en cadena2 y digitoActual no en resultadoFinal:
            resultadoFinal+=digitoActual
    por digitoActual en cadena2:
        si digitoActual no en cadena1 y digitoActual no en resultadoFinal:
            resultadoFinal+=digitoActual
    si resultadoFinal=="":
        retornar Falso
    retornar entero(resultadoFinal)

definir obtenerDiferenciaAux(ptupla):
    si tipo(ptupla)!=tupla:
        retornar "Debe recibir una tupla para analizar los valores"
    num1=ptupla[0]
    num2=ptupla[1]
    si tipo(num1)!=entero o tipo(num2)!=entero:
        retornar "Ambos valores deben ser enteros"
    si 0>num1 o 0>num2:
        retornar "Ambos valores deben ser mayores a 0"
    retornar obtenerDiferencia(num1, num2)

